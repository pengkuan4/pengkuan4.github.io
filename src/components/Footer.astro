---
import { person } from "@/data/personal";

const year = new Date().getFullYear();
---

<footer class="app-layout site-footer">
  <div class="footer-inner">
    <dl class="contact-list">
      <div>
        <dt>邮箱</dt>
        <dd><a href={`mailto:${person.email}`}>{person.email}</a></dd>
      </div>
      <div>
        <dt>微信</dt>
        <dd>{person.wechat}</dd>
      </div>
    </dl>
    <small class="copyright"
      >{person.name} <span aria-hidden="true">/</span> {year}</small
    >
  </div>
</footer>
