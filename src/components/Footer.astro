---
import type { HTMLAttributes } from "astro/types";
import { person } from "@/data/personal";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border text-muted-foreground flex items-center justify-between border-t py-8 text-sm"
  >
    <span>{person.name}</span>
    <span>{currentYear}</span>
  </div>
</footer>
