---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = { notes: CollectionEntry<"notes">[] };
const { notes } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
---

<ul class="note-list">
  {
    notes.map(note => (
      <li>
        <a href={getRelativeLocaleUrl(locale, `notes/${note.id}`)}>
          <time datetime={note.data.datetime}>
            {note.data.date ?? note.data.datetime.replaceAll("-", ".")}
          </time>
          <span class="note-title">{note.data.title}</span>
          <span class="note-category">{note.data.category}</span>
        </a>
      </li>
    ))
  }
</ul>
