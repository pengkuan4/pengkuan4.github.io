---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getAssetPath, stripBase, stripLocale } from "@/utils/withBase";
import { person } from "@/data/personal";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const currentPath = stripLocale(stripBase(Astro.url.pathname), locale);
const links = [
  { path: "", label: "首页" },
  { path: "notes", label: "文字" },
  { path: "moments", label: "影像" },
];
---

<a class="skip-link" href="#main-content">跳至正文</a>
<header class="app-layout site-header">
  <a
    class="wordmark"
    href={getRelativeLocaleUrl(locale, "")}
    aria-label={`${person.name}的首页`}
  >
    <img src={getAssetPath("favicon.svg")} alt="" width="28" height="28" />
  </a>
  <nav class="site-nav" aria-label="主导航">
    {
      links.map(({ path, label }) => (
        <a
          href={getRelativeLocaleUrl(locale, path)}
          aria-current={
            (path ? currentPath.startsWith(`/${path}`) : currentPath === "/")
              ? "page"
              : undefined
          }
        >
          {label}
        </a>
      ))
    }
  </nav>
</header>
