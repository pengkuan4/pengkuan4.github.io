---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout title={`页面不存在 | ${config.site.title}`}>
  <Header />
  <main id="main-content" class="app-layout archive-main not-found">
    <h1>404</h1>
    <p>这一页不在这里。</p>
    <a class="text-link" href={getRelativeLocaleUrl(locale, "")}>回到首页</a>
  </main>
  <Footer />
</Layout>
