---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout
  title={`写随记 | ${config.site.title}`}
  description="彭宽个人小站的写作入口。"
>
  <Header />
  <main id="main-content" class="app-layout pt-8 pb-16 sm:pt-10 sm:pb-20">
    <section class="mx-auto max-w-4xl">
      <LinkButton
        href={getRelativeLocaleUrl(locale, "notes")}
        class="text-muted-foreground hover:text-accent inline-flex items-center gap-2 text-sm font-medium"
      >
        <IconArrowLeft class="size-4" />
        返回随记
      </LinkButton>

      <div class="border-border mt-7 border-b pb-8">
        <p class="text-muted-foreground text-xs tracking-[0.24em] uppercase">
          Private
        </p>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">
          写一篇新的随记
        </h1>
        <p class="text-muted-foreground mt-4 max-w-2xl text-sm leading-6">
          这个入口会用你的 GitHub 身份把文章提交到仓库。只有登录账号为 pengkuan4
          且拥有仓库写入权限时，提交才会成功。
        </p>
      </div>

      <form class="mt-8 grid gap-5" data-editor-form autocomplete="off">
        <section
          class="border-border bg-background rounded-[1.25rem] border p-5"
        >
          <div class="grid gap-4 md:grid-cols-[1fr_0.45fr]">
            <label class="block">
              <span class="text-sm font-medium">GitHub Token</span>
              <input
                class="border-border bg-background mt-2 w-full rounded-xl border px-3 py-3 text-sm"
                data-field="token"
                placeholder="只保存在你的浏览器里"
                type="password"
              />
            </label>

            <label class="mt-8 flex items-center gap-2 text-sm">
              <input
                class="accent-accent size-4"
                data-field="remember"
                type="checkbox"
              />
              <span>在这台浏览器记住 Token</span>
            </label>
          </div>
        </section>

        <section
          class="border-border bg-background rounded-[1.25rem] border p-5"
        >
          <div class="grid gap-4 md:grid-cols-2">
            <label class="block md:col-span-2">
              <span class="text-sm font-medium">标题</span>
              <input
                class="border-border bg-background mt-2 w-full rounded-xl border px-3 py-3 text-sm"
                data-field="title"
                placeholder="今天想写点什么"
                required
                type="text"
              />
            </label>

            <label class="block">
              <span class="text-sm font-medium">地址 slug</span>
              <input
                class="border-border bg-background mt-2 w-full rounded-xl border px-3 py-3 text-sm"
                data-field="slug"
                placeholder="note-2026-09-14"
                required
                type="text"
              />
            </label>

            <label class="block">
              <span class="text-sm font-medium">日期</span>
              <input
                class="border-border bg-background mt-2 w-full rounded-xl border px-3 py-3 text-sm"
                data-field="date"
                required
                type="date"
              />
            </label>

            <label class="block">
              <span class="text-sm font-medium">状态</span>
              <input
                class="border-border bg-background mt-2 w-full rounded-xl border px-3 py-3 text-sm"
                data-field="mood"
                placeholder="随记"
                type="text"
                value="随记"
              />
            </label>

            <label class="block">
              <span class="text-sm font-medium">标签</span>
              <input
                class="border-border bg-background mt-2 w-full rounded-xl border px-3 py-3 text-sm"
                data-field="tags"
                placeholder="日常, 想法"
                type="text"
              />
            </label>

            <label class="block md:col-span-2">
              <span class="text-sm font-medium">摘要</span>
              <textarea
                class="border-border bg-background mt-2 min-h-24 w-full rounded-xl border px-3 py-3 text-sm leading-6"
                data-field="excerpt"
                placeholder="列表页显示的一小段说明"></textarea>
            </label>

            <label class="block md:col-span-2">
              <span class="text-sm font-medium">正文</span>
              <textarea
                class="border-border bg-background mt-2 min-h-72 w-full rounded-xl border px-3 py-3 text-sm leading-7"
                data-field="body"
                placeholder="正文可以直接分段写，空一行就是新段落。"
                required></textarea>
            </label>
          </div>
        </section>

        <div
          class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
        >
          <p class="text-muted-foreground text-sm leading-6" data-status>
            准备好后提交，发布完成通常需要等待 GitHub Pages 构建一会儿。
          </p>
          <button
            class="bg-accent text-accent-foreground inline-flex w-fit items-center justify-center rounded-full px-5 py-3 text-sm font-semibold disabled:cursor-not-allowed disabled:opacity-60"
            data-submit
            type="submit"
          >
            提交随记
          </button>
        </div>
      </form>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const REPO_OWNER = "pengkuan4";
  const REPO_NAME = "pengkuan4.github.io";
  const BRANCH = "main";
  const ADMIN_LOGIN = "pengkuan4";
  const TOKEN_STORAGE_KEY = "pengkuan-site-editor-token";

  const form = document.querySelector<HTMLFormElement>("[data-editor-form]");
  const statusNode = document.querySelector<HTMLElement>("[data-status]");
  const submitButton =
    document.querySelector<HTMLButtonElement>("[data-submit]");
  const fields = Object.fromEntries(
    Array.from(
      document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
        "[data-field]"
      )
    ).map(field => [field.dataset.field, field])
  ) as Record<
    | "token"
    | "remember"
    | "title"
    | "slug"
    | "date"
    | "mood"
    | "tags"
    | "excerpt"
    | "body",
    HTMLInputElement | HTMLTextAreaElement
  >;

  const setStatus = (message: string, tone: "muted" | "ok" | "error") => {
    if (!statusNode) return;

    statusNode.textContent = message;
    statusNode.classList.toggle("text-accent", tone === "ok");
    statusNode.classList.toggle("text-red-600", tone === "error");
    statusNode.classList.toggle("text-muted-foreground", tone === "muted");
  };

  const today = () => new Date().toISOString().slice(0, 10);

  const toDisplayDate = (date: string) => date.replaceAll("-", ".");

  const slugify = (value: string) => {
    const slug = value
      .toLowerCase()
      .trim()
      .replace(/['"]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");

    if (slug) return slug;

    const now = new Date();
    const time = `${String(now.getHours()).padStart(2, "0")}${String(
      now.getMinutes()
    ).padStart(2, "0")}`;
    return `note-${today()}-${time}`;
  };

  const encodeBase64 = (value: string) => {
    const bytes = new TextEncoder().encode(value);
    let binary = "";
    bytes.forEach(byte => {
      binary += String.fromCharCode(byte);
    });
    return btoa(binary);
  };

  const apiHeaders = (token: string) => ({
    Accept: "application/vnd.github+json",
    Authorization: `Bearer ${token}`,
    "Content-Type": "application/json",
    "X-GitHub-Api-Version": "2022-11-28",
  });

  const readError = async (response: Response) => {
    const data = await response.json().catch(() => null);
    return data?.message
      ? `${response.status} ${data.message}`
      : `${response.status} ${response.statusText}`;
  };

  const buildMarkdown = () => {
    const title = fields.title.value.trim();
    const date = fields.date.value || today();
    const mood = fields.mood.value.trim() || "随记";
    const body = fields.body.value.trim();
    const tags = fields.tags.value
      .split(/[,，]/)
      .map(tag => tag.trim())
      .filter(Boolean);
    const excerpt =
      fields.excerpt.value.trim() ||
      body
        .split(/\r?\n\s*\r?\n/)
        .find(Boolean)
        ?.slice(0, 120) ||
      title;

    return `---\ntitle: ${JSON.stringify(title)}\ndate: ${JSON.stringify(
      toDisplayDate(date)
    )}\ndatetime: ${JSON.stringify(date)}\nmood: ${JSON.stringify(
      mood
    )}\nexcerpt: ${JSON.stringify(excerpt)}\ntags: ${JSON.stringify(
      tags
    )}\n---\n\n${body}\n`;
  };

  const verifyOwner = async (token: string) => {
    const response = await fetch("https://api.github.com/user", {
      headers: apiHeaders(token),
    });

    if (!response.ok) {
      throw new Error(`GitHub 身份验证失败：${await readError(response)}`);
    }

    const user = await response.json();

    if (user.login !== ADMIN_LOGIN) {
      throw new Error(`当前登录账号是 ${user.login}，不是 ${ADMIN_LOGIN}。`);
    }
  };

  const ensureNewFile = async (token: string, path: string) => {
    const url = `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${encodeURIComponent(
      path
    ).replaceAll("%2F", "/")}?ref=${BRANCH}`;
    const response = await fetch(url, {
      headers: apiHeaders(token),
    });

    if (response.ok) {
      throw new Error("这个 slug 已经存在，请换一个地址。");
    }

    if (response.status !== 404) {
      throw new Error(`检查文章是否存在时失败：${await readError(response)}`);
    }
  };

  const createNote = async (token: string, path: string, markdown: string) => {
    const url = `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${encodeURIComponent(
      path
    ).replaceAll("%2F", "/")}`;
    const response = await fetch(url, {
      body: JSON.stringify({
        branch: BRANCH,
        content: encodeBase64(markdown),
        message: `Add note: ${fields.title.value.trim()}`,
      }),
      headers: apiHeaders(token),
      method: "PUT",
    });

    if (!response.ok) {
      throw new Error(`提交文章失败：${await readError(response)}`);
    }
  };

  if (fields.date) fields.date.value = today();

  const storedToken = localStorage.getItem(TOKEN_STORAGE_KEY);
  if (storedToken) {
    fields.token.value = storedToken;
    (fields.remember as HTMLInputElement).checked = true;
  }

  fields.title.addEventListener("input", () => {
    if (!fields.slug.value.trim()) {
      fields.slug.value = slugify(fields.title.value);
    }
  });

  fields.slug.addEventListener("input", () => {
    fields.slug.value = slugify(fields.slug.value);
  });

  form?.addEventListener("submit", async event => {
    event.preventDefault();

    const token = fields.token.value.trim();
    const title = fields.title.value.trim();
    const slug = slugify(fields.slug.value || title);
    const body = fields.body.value.trim();

    if (!token || !title || !slug || !body) {
      setStatus("Token、标题、地址和正文都需要填写。", "error");
      return;
    }

    const rememberToken = (fields.remember as HTMLInputElement).checked;
    if (rememberToken) {
      localStorage.setItem(TOKEN_STORAGE_KEY, token);
    } else {
      localStorage.removeItem(TOKEN_STORAGE_KEY);
    }

    submitButton?.setAttribute("disabled", "true");
    setStatus("正在验证身份并提交文章...", "muted");

    try {
      fields.slug.value = slug;
      const path = `src/content/notes/${slug}.md`;
      const markdown = buildMarkdown();

      await verifyOwner(token);
      await ensureNewFile(token, path);
      await createNote(token, path, markdown);

      setStatus(`已提交。发布完成后可以访问 /notes/${slug}/。`, "ok");
      form.reset();
      fields.date.value = today();
      if (rememberToken) {
        fields.token.value = token;
        (fields.remember as HTMLInputElement).checked = true;
      }
    } catch (error) {
      setStatus(error instanceof Error ? error.message : "提交失败。", "error");
    } finally {
      submitButton?.removeAttribute("disabled");
    }
  });
</script>
