---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { notes } from "@/data/notes";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout
  title={`随记 | ${config.site.title}`}
  description={config.site.description}
>
  <Header />
  <main id="main-content" class="app-layout py-16 sm:py-24">
    <h1 class="text-4xl font-normal tracking-normal sm:text-5xl">随记</h1>

    <section class="border-border mt-14 border-t">
      {
        notes.map(note => (
          <article class="border-border grid gap-3 border-b py-7 sm:grid-cols-[8rem_1fr]">
            <time
              class="text-muted-foreground text-sm"
              datetime={note.datetime}
            >
              {note.date}
            </time>
            <h2 class="text-xl font-normal">
              <a
                class="hover:text-accent underline-offset-4 hover:underline"
                href={getRelativeLocaleUrl(locale, `notes/${note.slug}`)}
              >
                {note.title}
              </a>
            </h2>
          </article>
        ))
      }
    </section>
  </main>
  <Footer />
</Layout>
