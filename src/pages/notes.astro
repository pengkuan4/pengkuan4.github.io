---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { notes } from "@/data/notes";
import { person } from "@/data/personal";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout
  title={`随想随记 | ${config.site.title}`}
  description="彭宽的随想随记，记录一些日常、想法和阶段性的整理。"
>
  <Header />
  <main id="main-content" class="app-layout pt-8 pb-16 sm:pt-10 sm:pb-20">
    <section class="border-border flex flex-col gap-5 border-b pb-8">
      <div class="max-w-3xl">
        <p class="text-muted-foreground text-xs tracking-[0.24em] uppercase">
          Notes
        </p>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">
          随想随记
        </h1>
        <p class="text-muted-foreground mt-4 text-base leading-7">
          {person.shortIntro}
          有些只是短短几句，有些会慢慢写长。这里先保存当下，之后再回头看。
        </p>
      </div>
    </section>

    <section class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {
        notes.map(note => (
          <article class="border-border bg-background flex h-full flex-col rounded-[1.25rem] border p-5">
            <div class="flex items-center justify-between gap-3">
              <time
                datetime={note.datetime}
                class="text-muted-foreground text-xs"
              >
                {note.date}
              </time>
              <span class="border-border text-muted-foreground rounded-full border px-2.5 py-1 text-xs">
                {note.mood}
              </span>
            </div>

            <h2 class="mt-4 text-lg font-semibold">{note.title}</h2>
            <p class="text-muted-foreground mt-3 grow text-sm leading-6">
              {note.excerpt}
            </p>

            <div class="mt-4 flex flex-wrap gap-2">
              {note.tags.map(tag => (
                <span class="border-border text-muted-foreground rounded-full border px-2.5 py-1 text-xs">
                  {tag}
                </span>
              ))}
            </div>

            <LinkButton
              href={getRelativeLocaleUrl(locale, `notes/${note.slug}`)}
              class="text-accent mt-5 inline-flex items-center gap-2 text-sm font-semibold"
            >
              继续读
              <IconArrowRight class="size-4" />
            </LinkButton>
          </article>
        ))
      }
    </section>
  </main>
  <Footer />
</Layout>
