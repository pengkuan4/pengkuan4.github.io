---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import IconGithub from "@/assets/icons/socials/github.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { latestNotes } from "@/data/notes";
import { person, homeMarks, quietTopics } from "@/data/personal";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout title={person.siteTitle} description={person.intro}>
  <Header />
  <main id="main-content" class="app-layout pt-8 pb-16 sm:pt-10 sm:pb-20">
    <section class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">
      <div class="space-y-7">
        <div
          class="border-border bg-background text-muted-foreground inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-xs font-medium"
        >
          <span class="bg-accent size-2 rounded-full" aria-hidden="true"></span>
          <span>个人介绍 · 随想随记</span>
        </div>

        <div class="space-y-5">
          <p
            class="text-muted-foreground text-sm font-medium tracking-[0.28em] uppercase"
          >
            Personal Site
          </p>
          <h1
            class="text-foreground max-w-3xl text-4xl font-semibold tracking-tight sm:text-5xl lg:text-6xl"
          >
            {person.siteTitle}
          </h1>
          <p class="text-muted-foreground max-w-2xl text-lg leading-8">
            {person.intro}
          </p>
        </div>

        <div class="flex flex-wrap gap-3">
          <LinkButton
            href={getRelativeLocaleUrl(locale, "notes")}
            class="bg-accent text-accent-foreground inline-flex items-center gap-2 rounded-full px-4 py-3 text-sm font-semibold"
          >
            读随记
            <IconArrowRight class="size-4" />
          </LinkButton>
          <LinkButton
            href={getRelativeLocaleUrl(locale, "about")}
            class="border-border inline-flex items-center gap-2 rounded-full border px-4 py-3 text-sm font-semibold"
          >
            关于我
          </LinkButton>
          <LinkButton
            href={person.github}
            target="_blank"
            rel="noreferrer"
            class="border-border inline-flex items-center gap-2 rounded-full border px-4 py-3 text-sm font-semibold"
          >
            <IconGithub class="size-4" />
            GitHub
          </LinkButton>
        </div>

        <div class="grid gap-3 sm:grid-cols-3">
          {
            homeMarks.map(item => (
              <div class="border-border bg-background rounded-2xl border p-4">
                <p class="text-muted-foreground text-xs tracking-[0.22em] uppercase">
                  {item.label}
                </p>
                <p class="mt-2 text-sm leading-6 font-medium">{item.value}</p>
              </div>
            ))
          }
        </div>
      </div>

      <aside class="border-border bg-background rounded-[1.5rem] border p-5">
        <div class="flex items-center justify-between gap-3">
          <div>
            <p
              class="text-muted-foreground text-xs tracking-[0.24em] uppercase"
            >
              Latest
            </p>
            <h2 class="mt-2 text-lg font-semibold">最近写下的</h2>
          </div>
          <span
            class="border-border text-muted-foreground rounded-full border px-2.5 py-1 text-xs"
          >
            随记
          </span>
        </div>

        <div class="mt-5 space-y-4">
          {
            latestNotes.map(note => (
              <a
                href={getRelativeLocaleUrl(locale, `notes/${note.slug}`)}
                class="border-border bg-muted/15 hover:border-accent/50 block rounded-2xl border p-4 transition-colors"
              >
                <div class="flex items-center justify-between gap-3">
                  <time
                    datetime={note.datetime}
                    class="text-muted-foreground text-xs"
                  >
                    {note.date}
                  </time>
                  <span class="border-border text-muted-foreground rounded-full border px-2.5 py-1 text-xs">
                    {note.mood}
                  </span>
                </div>
                <h3 class="mt-3 text-base font-semibold">{note.title}</h3>
                <p class="text-muted-foreground mt-2 line-clamp-2 text-sm leading-6">
                  {note.excerpt}
                </p>
              </a>
            ))
          }
        </div>
      </aside>
    </section>

    <section class="mt-16 grid gap-5 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="text-muted-foreground text-xs tracking-[0.24em] uppercase">
          Notes
        </p>
        <h2 class="mt-3 text-2xl font-semibold">
          这里会放一些不那么正式、但更接近我的文字
        </h2>
      </div>

      <div class="grid gap-4 md:grid-cols-3">
        {
          quietTopics.map(item => (
            <div class="border-border bg-background rounded-[1.25rem] border p-5">
              <h3 class="text-base font-semibold">{item.title}</h3>
              <p class="text-muted-foreground mt-3 text-sm leading-6">
                {item.summary}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <section
      class="border-border bg-background mt-16 rounded-[1.5rem] border p-5 sm:p-6"
    >
      <div
        class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
      >
        <div>
          <p class="text-muted-foreground text-xs tracking-[0.24em] uppercase">
            Slowly
          </p>
          <h2 class="mt-2 text-2xl font-semibold">
            先让它成为一个愿意回来写两句的地方
          </h2>
          <p class="text-muted-foreground mt-3 max-w-2xl text-sm leading-6">
            {person.note}
          </p>
        </div>
        <LinkButton
          href={getRelativeLocaleUrl(locale, "notes")}
          class="bg-accent text-accent-foreground inline-flex w-fit items-center gap-2 rounded-full px-4 py-3 text-sm font-semibold"
        >
          打开随记
          <IconArrowRight class="size-4" />
        </LinkButton>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
