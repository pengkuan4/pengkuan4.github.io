---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import NoteList from "@/components/NoteList.astro";
import Moment from "@/components/Moment.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getNotes } from "@/data/notes";
import { getMoments } from "@/data/moments";
import { person } from "@/data/personal";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const [notes, moments] = await Promise.all([getNotes(), getMoments()]);
---

<Layout title={person.siteTitle}>
  <Header />
  <main id="main-content" class="app-layout home-main">
    <section class="introduction" aria-labelledby="name">
      <h1 id="name">{person.name}</h1>
      <p class="personal-details">{person.details}</p>
      <div class="personal-prose">
        <p>{person.introduction}</p>
        <p>{person.interests}</p>
      </div>
    </section>

    <section class="home-section" aria-labelledby="writing-title">
      <a class="section-link" href={getRelativeLocaleUrl(locale, "notes")}>
        <h2 id="writing-title">文字</h2>
        <span class="section-meta"
          ><span>{String(notes.length).padStart(2, "0")}</span><IconArrowRight
            aria-hidden="true"
          /></span
        >
      </a>
      {notes.length > 0 && <NoteList notes={notes.slice(0, 5)} />}
    </section>

    <section class="home-section" aria-labelledby="moments-title">
      <a class="section-link" href={getRelativeLocaleUrl(locale, "moments")}>
        <h2 id="moments-title">影像</h2>
        <span class="section-meta"
          ><span>{String(moments.length).padStart(2, "0")}</span><IconArrowRight
            aria-hidden="true"
          /></span
        >
      </a>
      {
        moments.length > 0 && (
          <div class="home-moments">
            {moments.slice(0, 2).map(moment => (
              <Moment {moment} />
            ))}
          </div>
        )
      }
    </section>
  </main>
  <Footer />
</Layout>
