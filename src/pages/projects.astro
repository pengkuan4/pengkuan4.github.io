---
import IconGithub from "@/assets/icons/socials/github.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { profile, projectSlots } from "@/data/portfolio";
import config from "@/config";
---

<Layout
  title={`项目 | ${config.site.title}`}
  description="彭宽的项目作品集合，预留截图、技术栈、链接和结果说明。"
>
  <Header />
  <main id="main-content" class="app-layout pt-8 pb-16 sm:pt-10 sm:pb-20">
    <section
      class="border-border flex flex-col gap-5 border-b pb-8 sm:flex-row sm:items-end sm:justify-between"
    >
      <div class="max-w-2xl">
        <p class="text-muted-foreground text-xs tracking-[0.24em] uppercase">
          Projects
        </p>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">
          作品集合
        </h1>
        <p class="text-muted-foreground mt-4 text-base leading-7">
          这里预留了统一的项目结构：截图、简介、技术栈、链接和结果。后续增加真实项目时，只需要替换对应内容。
        </p>
      </div>
      <LinkButton
        href={profile.github}
        target="_blank"
        rel="noreferrer"
        class="border-border inline-flex w-fit items-center gap-2 rounded-full border px-4 py-3 text-sm font-semibold"
      >
        <IconGithub class="size-4" />
        GitHub
      </LinkButton>
    </section>

    <section class="mt-8">
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {projectSlots.map(project => <ProjectCard {...project} />)}
      </div>
    </section>

    <section class="border-border mt-12 border-t pt-6">
      <div class="grid gap-4 md:grid-cols-3">
        <div>
          <p class="text-muted-foreground text-xs tracking-[0.24em] uppercase">
            Preview
          </p>
          <p class="text-muted-foreground mt-2 text-sm leading-6">
            每个项目都有固定比例的截图位，页面不会因为图片尺寸不同而跳动。
          </p>
        </div>
        <div>
          <p class="text-muted-foreground text-xs tracking-[0.24em] uppercase">
            Context
          </p>
          <p class="text-muted-foreground mt-2 text-sm leading-6">
            项目说明优先讲问题、你的角色和交付结果，不堆砌技术名词。
          </p>
        </div>
        <div>
          <p class="text-muted-foreground text-xs tracking-[0.24em] uppercase">
            Links
          </p>
          <p class="text-muted-foreground mt-2 text-sm leading-6">
            后续可以添加 GitHub、在线演示、视频或完整案例说明链接。
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
