---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import IconGithub from "@/assets/icons/socials/github.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { aboutBlocks, person, quietTopics } from "@/data/personal";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout title={`关于 | ${config.site.title}`} description={person.intro}>
  <Header />
  <main id="main-content" class="app-layout pt-8 pb-16 sm:pt-10 sm:pb-20">
    <section
      class="border-border grid gap-8 border-b pb-10 lg:grid-cols-[1.05fr_0.95fr]"
    >
      <div>
        <p class="text-muted-foreground text-xs tracking-[0.24em] uppercase">
          About
        </p>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">
          关于我，也关于这个正在慢慢长出来的小站。
        </h1>
        <p class="text-muted-foreground mt-5 max-w-2xl text-base leading-7">
          {person.intro}
        </p>
        <p class="text-muted-foreground mt-4 max-w-2xl text-sm leading-6">
          {person.note}
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <LinkButton
            href={getRelativeLocaleUrl(locale, "notes")}
            class="bg-accent text-accent-foreground inline-flex items-center gap-2 rounded-full px-4 py-3 text-sm font-semibold"
          >
            读随记
            <IconArrowRight class="size-4" />
          </LinkButton>
          <LinkButton
            href={person.github}
            target="_blank"
            rel="noreferrer"
            class="border-border inline-flex items-center gap-2 rounded-full border px-4 py-3 text-sm font-semibold"
          >
            <IconGithub class="size-4" />
            GitHub
          </LinkButton>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
        {
          aboutBlocks.map(block => (
            <div class="border-border bg-background rounded-[1.25rem] border p-5">
              <h2 class="text-base font-semibold">{block.title}</h2>
              <p class="text-muted-foreground mt-3 text-sm leading-6">
                {block.summary}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-10 grid gap-8 lg:grid-cols-[0.95fr_1.05fr]">
      <div>
        <p class="text-muted-foreground text-xs tracking-[0.24em] uppercase">
          What I Write
        </p>
        <h2 class="mt-3 text-2xl font-semibold">我想在这里记录什么</h2>
        <p class="text-muted-foreground mt-4 max-w-xl text-sm leading-6">
          不把它做成很重的栏目，也不急着固定一种风格。只要是真实想写下来的东西，都可以先放进来。
        </p>
      </div>

      <div class="space-y-5">
        {
          quietTopics.map((item, index) => (
            <div class="flex gap-4">
              <p class="text-accent shrink-0 text-sm font-semibold">
                {String(index + 1).padStart(2, "0")}
              </p>
              <div>
                <h3 class="text-base font-semibold">{item.title}</h3>
                <p class="text-muted-foreground mt-2 text-sm leading-6">
                  {item.summary}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </main>
  <Footer />
</Layout>
