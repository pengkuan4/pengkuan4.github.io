---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { notes, type ThoughtNote } from "@/data/notes";
import config from "@/config";

type Props = {
  note: ThoughtNote;
};

export function getStaticPaths() {
  return notes.map(note => ({
    params: { slug: note.slug },
    props: { note },
  }));
}

const { note } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout
  title={`${note.title} | ${config.site.title}`}
  description={note.excerpt}
>
  <Header />
  <main id="main-content" class="app-layout py-14 sm:py-20">
    <article class="max-w-3xl">
      <a
        href={getRelativeLocaleUrl(locale, "notes")}
        class="text-muted-foreground hover:text-accent text-sm underline-offset-4 hover:underline"
      >
        返回随记
      </a>

      <header class="border-border mt-10 border-b pb-10">
        <time datetime={note.datetime} class="text-muted-foreground text-sm">
          {note.date}
        </time>
        <h1 class="mt-5 text-4xl font-normal tracking-normal sm:text-5xl">
          {note.title}
        </h1>
      </header>

      <div class="mt-10 max-w-2xl space-y-6 text-base leading-9">
        {note.body.map(paragraph => <p>{paragraph}</p>)}
      </div>
    </article>
  </main>
  <Footer />
</Layout>
