---
import { render, type CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import { getNotes } from "@/data/notes";
import config from "@/config";

type Props = { note: CollectionEntry<"notes"> };

export async function getStaticPaths() {
  return (await getNotes()).map(note => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout
  title={`${note.data.title} | ${config.site.title}`}
  description={note.data.excerpt ??
    `${note.data.title}，彭宽的${note.data.category}。`}
>
  <Header />
  <main id="main-content" class="app-layout article-main">
    <a class="back-link" href={getRelativeLocaleUrl(locale, "notes")}
      ><IconArrowLeft aria-hidden="true" />文字</a
    >
    <article>
      <header class="article-heading">
        <p class="article-meta">
          <time datetime={note.data.datetime}
            >{note.data.date ?? note.data.datetime.replaceAll("-", ".")}</time
          ><span>{note.data.category}</span>
        </p>
        <h1>{note.data.title}</h1>
      </header>
      <div class="app-prose article-body"><Content /></div>
    </article>
    <a
      class="back-link article-return"
      href={getRelativeLocaleUrl(locale, "notes")}
      ><IconArrowLeft aria-hidden="true" />全部文字</a
    >
  </main>
  <Footer />
</Layout>
